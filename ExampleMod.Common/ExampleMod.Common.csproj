<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <OutputType>Library</OutputType>
        <Platforms>AnyCPU</Platforms>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <!--
        Targets netstandard2.0 so both the client mod (netstandard2.0) and the
        server mod (net10.0) can reference this assembly.

        Private=false keeps the netstandard2.0 SDK assemblies out of the server
        mod's output folder, where the net10.0 builds from Dependencies/ServerSDK
        have to win.
    -->

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ReadyM.SDK.Wukong.Common" Version="0.3.1-preview.1" />
    </ItemGroup>
</Project>
